# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
OTP_HASH_SECRET=your_long_random_otp_hash_secret

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Upstash Rate Limiting & Caching
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Resend Emails
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_ADDRESS="Root & Loom <root@your_verified_domain.com>"

# Sentry Error Monitoring
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# MSG91 SMS Delivery (Primary DLT-Compliant Mobile OTP)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_FLOW_ID=your_msg91_flow_id
MSG91_OTP_VAR_NAME=OTP
MSG91_TEMPLATE_ID=6a8ae88de4600371d60f7913
MSG91_DLT_TEMPLATE_ID=1007453585041828015
MSG91_SENDER_ID=SHRMFL
SUPABASE_SMS_HOOK_SECRET=your_supabase_sms_hook_secret

# Twilio SMS Fallback
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

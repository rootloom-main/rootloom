# Staging Environment specific variables
# Use a separate Supabase project for staging to ensure production data is safe
NEXT_PUBLIC_SUPABASE_URL=your_staging_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_staging_supabase_anon_key

# Test Keys for Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourkey
RAZORPAY_KEY_SECRET=your_test_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# Other Staging Keys
NEXT_PUBLIC_POSTHOG_KEY=your_staging_posthog_key
NEXT_PUBLIC_SENTRY_DSN=your_staging_sentry_dsn
UPSTASH_REDIS_REST_URL=your_staging_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_staging_upstash_token
RESEND_API_KEY=your_staging_resend_api_key

# App URL for webhook/callbacks in staging
NEXT_PUBLIC_SITE_URL=https://staging.rootloom.com

# Production Environment specific variables
NEXT_PUBLIC_SUPABASE_URL=your_production_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_supabase_anon_key

# Live Keys for Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_yourkey
RAZORPAY_KEY_SECRET=your_live_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret

# Production Analytics & Monitoring
NEXT_PUBLIC_POSTHOG_KEY=your_production_posthog_key
NEXT_PUBLIC_SENTRY_DSN=your_production_sentry_dsn

# Production Redis & Email
UPSTASH_REDIS_REST_URL=your_production_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_production_upstash_token
RESEND_API_KEY=your_production_resend_api_key

# App URL
NEXT_PUBLIC_SITE_URL=https://rootloom.com
